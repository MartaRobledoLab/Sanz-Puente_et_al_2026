mydata = read.table("blast_identity_frequency.Rtab")
png(filename = "blast_identify_frequency.png", width = 6, height = 4, units = "in", res = 300)
plot(mydata,main="Number of blastp hits with different percentage identity",  xlab="Blast percentage identity", ylab="No. blast results")
dev.off()

######################
conserved = colMeans(read.table("number_of_conserved_genes.Rtab"))
total = colMeans(read.table("number_of_genes_in_pan_genome.Rtab"))

genes = data.frame(
  genes_to_genomes = c(conserved, total),
  genomes = c(1:length(conserved), 1:length(total)),
  Key = c(rep("Conserved genes", length(conserved)), rep("Total genes", length(total)))
)

ggplot(data = genes, aes(x = genomes, y = genes_to_genomes, color = Key)) +
  geom_line(linewidth = 1) +
  scale_color_manual(values = c("Conserved genes" = "darkorange", "Total genes" = "darkgreen")) +
  theme_classic() +
  ylim(c(1, max(total))) +
  xlim(c(1, length(total))) +
  xlab("Number of genomes") +
  ylab("Number of genes") +
  theme(
    text = element_text(size = 16),
    legend.position = "none"
  )

ggsave(filename = "conserved_vs_total_genes.png", width = 5, height = 3, units = "in", dpi = 300)

######################

unique_genes = colMeans(read.table("number_of_unique_genes.Rtab"))
new_genes = colMeans(read.table("number_of_new_genes.Rtab"))

genes = data.frame( genes_to_genomes = c(unique_genes,new_genes),
                    genomes = c(c(1:length(unique_genes)),c(1:length(new_genes))),
                    Key = c(rep("Unique genes",length(unique_genes)), rep("New genes",length(new_genes))) )

ggplot(data = genes, aes(x = genomes, y = genes_to_genomes, color = Key)) +geom_line(linewidth = 1)+
  scale_color_manual(values = c("Unique genes" = "darkviolet", "New genes" = "red")) +
  theme_classic() +
  ylim(c(1,max(unique_genes)))+
  xlim(c(1,length(unique_genes)))+
  xlab("Number of genomes") +
  ylab("Number of genes")+ 
  theme(
    text = element_text(size = 16),
    legend.position="none")
ggsave(filename = "unique_vs_new_genes.png", width = 5, height = 3, units = "in", dpi = 300)

#----Los dos gráficos a la vez----
# Cargar datos
unique_genes = colMeans(read.table("number_of_unique_genes.Rtab"))
new_genes = colMeans(read.table("number_of_new_genes.Rtab"))
conserved = colMeans(read.table("number_of_conserved_genes.Rtab"))
total = colMeans(read.table("number_of_genes_in_pan_genome.Rtab"))

# Crear el data frame
genes = data.frame(
  genes_to_genomes = c(conserved, total, unique_genes, new_genes),
  genomes = c(1:length(conserved), 1:length(total), 1:length(unique_genes), 1:length(new_genes)),
  Key = c(rep("Core-genome", length(conserved)), 
          rep("Pan-genome", length(total)), 
          rep("Unique genes", length(unique_genes)), 
          rep("New genes", length(new_genes)))
)

# Graficar
ggplot(data = genes, aes(x = genomes, y = genes_to_genomes, color = Key)) +
  geom_line(linewidth = 1) +
  scale_color_manual(values = c("Unique genes" = "darkviolet", 
                                "New genes" = "red", 
                                "Core-genome" = "darkorange", 
                                "Pan-genome" = "darkgreen")) +
  theme_classic() +
  xlab("Number of genomes") +
  ylab("Number of genes") + 
  theme(
    text = element_text(size = 16),
    legend.position = "none"
  )

# Guardar la gráfica
ggsave(filename = "junto_NO_leyend.png", width = 5, height = 3, units = "in", dpi = 300)
